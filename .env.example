APP_ENV=dev
APP_NAME=day13-l3a-monitoring-llmops-lab
LOG_LEVEL=INFO
LOG_PATH=data/logs.jsonl
AUDIT_LOG_PATH=data/audit.jsonl
# Tự tạo project day13-k4-l3a-<MSSV>; không commit key thật.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
